# Production environment for sundram.tech (AWS EC2, ap-south-1/Mumbai).
# Copy to `.env` on the deploy host (`cp .env.production.example .env`),
# fill in every value marked CHANGE_ME, then `chmod 600 .env` — it holds
# real secrets. Never commit the filled-in file. Full runbook: docs/DEPLOY.md.

# --- shared ---
APP_ENV=production
LOG_LEVEL=info

# --- api (contract §4) ---
CORS_ORIGINS=https://sundram.tech
SCAN_TIMEOUT_SECONDS=25
SCAN_CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_IP_PER_HOUR=20
RATE_LIMIT_PER_HOSTNAME_PER_HOUR=6
PUBLIC_BASE_URL=https://sundram.tech
# Gates GET /api/v1/admin/stats. Generate with: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
# Gate C item 5. Sentry project DSN for the api process (and the arq
# worker, which shares this same value — see app/observability.py). Leave
# empty to run without error tracking; nothing else depends on it.
SENTRY_DSN=
# Phase 2 §7.6. Signs the sd_session cookie — every session becomes
# forgeable if this leaks or is left empty. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Phase 2 Step 2, CONTRACT GAP (see CONTRACT.md's v2.0 amendment note): OTP
# sign-in codes are sent through Resend. Leave both empty to run with OTP
# codes logged instead of emailed — never do that in production, sign-in
# would be broken for every real user.
RESEND_API_KEY=CHANGE_ME_resend_api_key
EMAIL_FROM_ADDRESS=CHANGE_ME_e.g._SUN-DRAM_Scanner_noreply@sundram.tech

# DATABASE_URL and REDIS_URL are NOT set here — docker-compose.prod.yml
# builds DATABASE_URL from POSTGRES_PASSWORD below and points REDIS_URL at
# the internal `redis` service automatically. Only override either if you
# are running Postgres/Redis somewhere other than this compose file.

# --- postgres ---
# Generate with: openssl rand -hex 24. Required — docker-compose.prod.yml
# refuses to start api/worker/postgres without it (no default password).
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# --- web (contract §4) ---
NEXT_PUBLIC_API_BASE_URL=https://sundram.tech
NEXT_PUBLIC_SITE_URL=https://sundram.tech
# Gate C item 5. Sentry project DSN for the browser/server/edge bundles
# (apps/web/sentry.*.config.ts). DSNs are write-only and not secret, but
# still opt-in: leave empty to run without error tracking.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Only needed to upload source maps to Sentry at build time
# (next.config.ts's withSentryConfig) — the build succeeds without them,
# just with unminified stack traces in Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- caddy ---
# A real, monitored inbox — Let's Encrypt sends expiry/revocation notices
# here, and ACME registration is rejected outright for placeholder domains
# (example.com, etc.), confirmed live while building this file.
CADDY_EMAIL=CHANGE_ME_you@sundram.tech

# --- backups (scripts/backup.sh, scripts/restore.sh) ---
# S3, ap-south-1 (Mumbai). Create the bucket first — see docs/DEPLOY.md's
# "Provision" step. No access key here, deliberately: the EC2 instance has
# an IAM role attached that grants it read/write on just this bucket, and
# aws-cli picks that up automatically from instance metadata. There is no
# key on disk to leak.
S3_BACKUP_BUCKET=CHANGE_ME_sun-dram-scanner-backups
AWS_REGION=ap-south-1
# How long nightly backups are kept in the bucket before scripts/backup.sh
# prunes them.
BACKUP_RETENTION_DAYS=30
