# --- shared ---
APP_ENV=development                 # development | staging | production
LOG_LEVEL=info

# --- api ---
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://scanner:scanner@postgres:5432/scanner
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
SCAN_TIMEOUT_SECONDS=25
SCAN_CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_IP_PER_HOUR=20
RATE_LIMIT_PER_HOSTNAME_PER_HOUR=6
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=                         # required to use GET /api/v1/admin/stats; empty disables it
SESSION_SECRET=dev-only-not-a-real-secret   # signs the sd_session cookie (contract §7.6); generate a real one for anything beyond local dev
RESEND_API_KEY=                      # empty = OTP codes are logged instead of emailed (app/notify/email.py)
EMAIL_FROM_ADDRESS=                  # e.g. "SUN-DRAM Scanner <noreply@sundram.tech>" — required alongside RESEND_API_KEY to actually send
SCHEDULER_MAX_CONCURRENT_SCANS=3     # caps concurrent scheduler-enqueued scans (app/scheduler.py) so a scheduled backlog never starves public scans
RAZORPAY_KEY_ID=                     # test-mode Razorpay key id — empty = INR checkout/webhooks refuse with INTERNAL_ERROR
RAZORPAY_KEY_SECRET=                 # paired with RAZORPAY_KEY_ID
RAZORPAY_WEBHOOK_SECRET=             # verifies X-Razorpay-Signature on POST /api/v1/billing/webhooks/razorpay
STRIPE_SECRET_KEY=                   # test-mode Stripe secret key (sk_test_...) — empty = USD checkout/webhooks refuse with INTERNAL_ERROR
STRIPE_WEBHOOK_SECRET=               # verifies Stripe-Signature on POST /api/v1/billing/webhooks/stripe (whsec_...)
ADMIN_DIGEST_EMAIL=                  # admin dashboard (§7.13) daily digest recipient; empty = digest computes and sends nothing
RATE_LIMIT_PDF_PER_IP_PER_HOUR=10    # PDF report export (§7.14) — separate, lower ceiling than RATE_LIMIT_PER_IP_PER_HOUR since a render is far more expensive than a scan-status read
PDF_CACHE_TTL_SECONDS=86400          # rendered PDF bytes are cached in Redis by scan_id for this long — a completed scan is immutable, so its PDF is too
PDF_MAX_CONCURRENT=2                 # caps concurrent WeasyPrint renders so the export path can never starve the scanner
OUTREACH_MAX_IMPORT_ROWS=500         # outreach orchestrator Stage 1 (§7.15/§17) — CSV import hard-rejects a file with more data rows than this
OUTREACH_MAX_CONCURRENT_SCANS=2      # outreach orchestrator Stage 2 (§7.16) — its own budget, smaller than SCHEDULER_MAX_CONCURRENT_SCANS, so a batch never starves public/scheduled scans
OUTREACH_SCAN_DELAY_SECONDS=15       # sequential pacing between outreach batch scans — the measured 98%-clean-scan-rate traffic profile
OUTREACH_MAX_SCAN_RETRIES=2          # retries after the first attempt (3 total) before a domain becomes FAILED
OUTREACH_RETRY_BACKOFF_SECONDS=300   # delay before a COMPLETED_PARTIAL domain's one re-scan, and before a RETRYING domain's next attempt

# --- web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
